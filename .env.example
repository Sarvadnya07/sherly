# OE-8 / FS-#5: Complete environment variable reference for Sherly AI
# Copy this file: cp .env.example .env
# Then fill in your values. All API keys are optional if using local Ollama.

# ── LLM API Keys (optional — leave blank to use local Ollama) ───────────
OPENAI_API_KEY=sk-...               # OpenAI GPT-4o-mini
GEMINI_API_KEY=AIzaSy...            # Google Gemini 1.5 Flash
GROQ_API_KEY=gsk_...                # Groq Llama3-70B (free tier available)

# ── Sherly Runtime Settings ───────────────────────────────────────────────
SHERLY_PHASE=A                      # Feature phase: A (basic), B (LLM planning), C (feedback loop)

# ── Local Ollama Configuration ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434   # Change if Ollama runs on a remote host or different port

# ── ChromaDB Vector Store ─────────────────────────────────────────────────
# Only needed if config.json chroma_config.mode = "server"
CHROMA_HOST=localhost
CHROMA_PORT=8000

# ── Ghost Mode ────────────────────────────────────────────────────────────
# Override the socket server port (default: 5555, also in config.json)
# GHOST_MODE_PORT=5555
