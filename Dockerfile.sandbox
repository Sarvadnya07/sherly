# Specialized Sandbox Image for Sherly AI
FROM python:3.11-slim

# Set working directory
WORKDIR /workspace

# Install common development tools
RUN apt-get update && apt-get install -y \
    git \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Pre-install common dependencies to speed up sandbox tasks
RUN pip install --no-cache-dir \
    requests \
    numpy \
    pandas \
    pytest

# Set a non-root user for security
RUN useradd -m sherly_runner
USER sherly_runner

# Entry point
CMD ["/bin/bash"]
