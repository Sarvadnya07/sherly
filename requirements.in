# requirements.in — FS-#3: Direct, unpinned dependencies for pip-compile
#
# Usage:
#   pip install pip-tools
#   pip-compile requirements.in --output-file requirements.txt
#   pip install -r requirements.txt   (for CI reproducible installs)
#
# Edit THIS file for dependency changes. Never edit requirements.txt by hand.

# ─── Core UI ──────────────────────────────────────────────────────────────
PySide6
pystray
Pillow

# ─── LLM / AI ─────────────────────────────────────────────────────────────
requests
tenacity
openai
google-generativeai
groq
pybreaker

# ─── Local model / audio ──────────────────────────────────────────────────
faster-whisper
sounddevice
numpy
scipy
pyttsx3

# ─── Vector store (RAG) ───────────────────────────────────────────────────
chromadb

# ─── Security & secrets ───────────────────────────────────────────────────
python-dotenv
cryptography

# ─── Web / browser ────────────────────────────────────────────────────────
duckduckgo-search
fastapi
uvicorn

# ─── Desktop automation ───────────────────────────────────────────────────
pyautogui
pyperclip
mss
pynput
pygetwindow
keyboard

# ─── System utilities ─────────────────────────────────────────────────────
psutil
psutil; sys_platform == "win32"
pywin32; sys_platform == "win32"

# ─── Structured logging (FS-#9, optional) ────────────────────────────────
# Uncomment to enable JSON log output:
# structlog

# ─── Playwright browser automation (optional) ────────────────────────────
# Uncomment when using BrowserAgent:
# playwright

# ─── WinRT biometrics (RC-2 / FS-#4, optional) ──────────────────────────
# Uncomment to enable real Windows Hello:
# winsdk; sys_platform == "win32"

# ─── Dev / test ──────────────────────────────────────────────────────────
pytest
pytest-mock
pytest-asyncio
pytest-cov
