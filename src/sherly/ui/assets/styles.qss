/* Main Window */
QMainWindow {
    background-color: #1e1e1e;
    color: #e0e0e0;
}

/* Assistant Panel / Dialogs */
QDialog {
    background-color: #1e1e1e;
}

/* Chat display */
QTextEdit {
    background-color: #2b2b2b;
    color: #e0e0e0;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 8px;
    font-size: 14px;
}

/* Input field */
QLineEdit {
    background-color: #333333;
    color: #ffffff;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px;
    font-size: 14px;
}

QLineEdit:focus {
    border: 1px solid #007acc;
}

/* Buttons */
QPushButton {
    background-color: #007acc;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #0098ff;
}

QPushButton:pressed {
    background-color: #005f9e;
}

QPushButton:disabled {
    background-color: #555555;
    color: #888888;
}

/* Labels */
QLabel {
    color: #cccccc;
    font-size: 12px;
}

/* Checkboxes */
QCheckBox {
    color: #cccccc;
}
